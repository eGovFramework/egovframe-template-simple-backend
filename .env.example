# docker-compose 실행 시 사용하는 환경 변수.
# 본 파일을 ".env"로 복사한 뒤 실제 값을 채워서 사용합니다.

APP_VERSION=5.0.0
MYSQL_VERSION=8.0.39

# 데이터베이스 자격증명 — 운영 환경에서는 충분히 강한 무작위 문자열로 교체
MYSQL_DATABASE=egovdb
MYSQL_USER=egov
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changemeRoot

# 구글제미나이 — API 키와 모델 명을 환경 변수로 설정
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here
API_MODEL=gemini-2.5-flash